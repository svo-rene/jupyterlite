{
  "name": "jupyterlite-forgejo",
  "version": "0.1.0",
  "description": "Sign in to a Forgejo instance and sync repositories with the JupyterLite file browser",
  "license": "BSD-3-Clause",
  "private": true,
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "jupyterlite",
    "forgejo"
  ],
  "files": [
    "lib/**/*.js",
    "schema/*.json",
    "style/*.css",
    "style/index.js"
  ],
  "main": "lib/index.js",
  "style": "style/index.css",
  "styleModule": "style/index.js",
  "scripts": {
    "build": "tsc && jupyter-builder build --development True .",
    "build:prod": "tsc && jupyter-builder build ."
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/coreutils": "^6.0.0",
    "@jupyterlab/filebrowser": "^4.0.0",
    "@jupyterlab/services": "^7.0.0",
    "@jupyterlab/settingregistry": "^4.0.0",
    "@jupyterlab/ui-components": "^4.0.0",
    "@lumino/widgets": "^2.0.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.3",
    "@jupyterlab/core-meta": "~4.6.4",
    "typescript": "~5.5.4"
  },
  "jupyterlab": {
    "extension": true,
    "schemaDir": "schema",
    "outputDir": "labextensions/jupyterlite-forgejo"
  }
}
